# MySQL 8 connection. Use a dedicated, least-privilege production account.
DATABASE_URL="mysql://lumen:change-me@127.0.0.1:3306/lumen"
# Enable this for a remote database. Optionally provide the provider's CA file.
DATABASE_SSL="false"
# DATABASE_SSL_CA="/absolute/path/to/mysql-ca.pem"

# The canonical public origin, used to protect all write requests from CSRF.
APP_URL="http://localhost:3000"

# Single administrator. Generate both values with: pnpm password:hash
ADMIN_USERNAME="your-admin-name"
ADMIN_PASSWORD_HASH="scrypt:32768:8:1:paste-generated-value-here"
SESSION_SECRET="paste-a-generated-32-byte-or-longer-secret-here"

# Keep uploaded originals outside public/. This directory is gitignored.
UPLOAD_DIR="./data/uploads"
